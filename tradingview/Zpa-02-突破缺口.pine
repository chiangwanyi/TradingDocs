//@version=6
// ═══════════════════════════════════════════════════════════════════════════════
//  Zpa 02 · 突破缺口（Gap）
//  ──────────────────────────────────────────────────────────────────────────────
//  依据：「Z说交易」概念库 02-缺口理论（体系最重要、最依赖的工具，
//        他坦言整个体系「70% 都和缺口相关」）
//
//  ── 口径（体系原文，非「跳空」）────────────────────────────────────────────
//  〔缺口+杂谈（一）179-185〕
//    「有一根很好的这根阳线的低点，当被阴线的实体突破，并且有跟随的时候，
//      就制造出了缺口，所以说多头需要在这里解套 —— 这个低点就是突破性缺口」
//  〔缺口+杂谈（一）193-194〕
//    「一根比较好的阴线被这个多头实体 k 线突破，并且有跟随的时候就产生的缺口」
//  〔缺口+杂谈（一）197-199〕
//    「并不是说非要有跟随，当这根实体收在上面的时候，就已经有缺口制造」
//  〔缺口+杂谈（三）1132〕
//    「（差信号 K）大概率没有办法会对前一根 k 线的这个低点高点或者波段高低点
//      会制造出缺口」
//
//  ⇒ 缺口是一个「价位」，不是一段跳空区间：
//      向下缺口位 = 被阴线实体（收盘价）跌破的那根【阳线的最低价】
//      向上缺口位 = 被阳线实体（收盘价）突破的那根【阴线的最高价】
//    那个价位就是「被套方打平离场」的位置，也就是支撑阻力。
//
//  参考 K 线的取法：从触发 K 往前找【最近的一根反向实体 K 线】，
//  中间可以隔着同向 K 线 —— 即 `B1阳 / B2阴 / B3阴，B3 收盘 < B1 最低`
//  这种情形（B2 没跌破，B3 跌破了），缺口位仍是 B1 的最低价。
//
//  ⚠ 旧的「相邻两根 K 线引线/实体不重叠」是**跳空**口径，与体系无关，已弃用。
//
//  ── 缺口行为三要点（本脚本量化）────────────────────────────────────────────
//    ① 能否制造缺口  → 触发后能否长时间敞开（撑过 N 根 = 有跟随 = 突破型）
//    ② 能否回补缺口  → 回补耗时（N 根内快速回补 = 假突破 / 弱趋势或震荡）
//    ③ 回补后是否恢复 → 缺口的被套方能否打平（引线触及该价位即算打平）
//
//  回补判据：价格【引线触及】缺口位即算回补（对应「限价单能在该价位打平」）。
//  去重规则：同方向 + 同价位上若已有【未回补】缺口 → 不另记（那是同一批被套方）；
//  缺口一旦回补就「让出」该价位，之后再次被反向实体突破 = 一批【新的】被套方。
//
//  免责：按该体系的分析推演，不构成投资建议。
// ═══════════════════════════════════════════════════════════════════════════════
indicator("Zpa 02 · 突破缺口（Gap）", "Zpa Gaps", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 200, max_bars_back = 1000)


// ═══════════════════════════════════ 参数 ═══════════════════════════════════

string G1 = "缺口判定口径"
int    minDepthT = input.int(1, "最小破位深度（tick）", minval = 1, maxval = 200, group = G1, tooltip = "触发 K 的收盘价必须收在被突破极值之外至少这么多 tick，才算「实体突破」。用小值即可，只用于滤除同价噪声。")

string G2 = "缺口分类"
int    followBars = input.int(3, "「有跟随」确认根数", minval = 1, maxval = 30, group = G2, tooltip = "体系：假突破 = 突破后没有跟随、很快跌回来让人解套。缺口撑过 N 根仍未被回补，即确认「有跟随」→ 突破型缺口。")
int    fakeBars   = input.int(2, "「假突破」快速回补根数", minval = 1, maxval = 30, group = G2, tooltip = "体系：制造出缺口、下根 K 就被回补、无法长时间敞开 → 假突破 / 突破失败，弱趋势或震荡。")

string G3 = "微缺口（隔一根的微型缺口）"
bool   showMicro = input.bool(true, "显示微缺口", group = G3, tooltip = "体系：前一根 K 线和后一根 K 线、中间一根 K 隔开，三根 K 线中间的这个微型缺口。单腿趋势的微通道微缺口测量非常有效。")
float  microAtr  = input.float(0.30, "微缺口宽度上限（ATR ×）", minval = 0.05, maxval = 2.0, step = 0.05, group = G3, tooltip = "只把「小」的隔根缺口算微缺口，超过该宽度视为普通缺口。")

string G4 = "Measured Move 投影（测量缺口）"
bool   showMM    = input.bool(true, "对未回补缺口显示 MM 目标位", group = G4, tooltip = "体系：未回补的缺口是测量型缺口，会到一个 Measured Move 位置，可据此设预期、设方向、设止盈。")
int    legLook   = input.int(20, "MM 幅度：缺口前波段回看（根）", minval = 5, maxval = 200, group = G4, tooltip = "MM 幅度 = 缺口前 N 根的波段高度（最高-最低），从缺口位等距投影。这是工程近似，面板会公开取值。")
int    mmMaxShow = input.int(2, "最多显示几个 MM 目标", minval = 1, maxval = 5, group = G4)

string G5 = "显示"
int    keepMax   = input.int(60, "最多保留缺口数（仅影响绘图/面板，不影响口径）", minval = 5, maxval = 400, group = G5, tooltip = "去重用的「未回补登记表」不参与裁剪，所以调小这个值只会少画线、少列历史，不会改变缺口检出与未回补计数。")
int    extendBars = input.int(60, "未回补缺口向右延伸（根）", minval = 0, maxval = 400, group = G5)
bool   showTag   = input.bool(true, "显示缺口标签", group = G5)
bool   showPanel = input.bool(true, "显示缺口清单面板", group = G5)
int    panelRows = input.int(9, "面板列出条数", minval = 3, maxval = 20, group = G5)
bool   markLast  = input.bool(true, "高亮「最后一个缺口」", group = G5, tooltip = "体系：最后一个缺口往往代表「引导这段趋势开始的机构」，与精准 MM 缺口同样强。")
color  upCol     = input.color(#26a69a, "向上缺口（阴线高点被突破）", group = G5)
color  dnCol     = input.color(#ef5350, "向下缺口（阳线低点被跌破）", group = G5)
color  filledCol = input.color(color.gray, "已回补", group = G5)


// ═══════════════════════════════ 数据容器 ═══════════════════════════════
// 【两张表，职责必须分离】
//   ① 未回补登记表 oLevel/oDir/oBorn —— 口径的唯一来源。只存【未回补】缺口，
//      回补即移除。它同时充当「去重表」，因此【绝不裁剪】——
//      未回补数天然收敛（回补的会被摘掉），所以它始终很小。
//      回补扫描与去重都只扫它 ⇒ 复杂度 O(未回补数)，与图表长度无关。
//   ② 绘图/历史表 aLevel… —— 只管画线、写标签、做统计，受「最多保留缺口数」裁剪。
//   ⚠ 曾把两者合成一张表：裁剪会「让出」未回补价位 → 重复检出，
//     即【口径被渲染容量污染】。渲染容量与口径容量必须解耦。

// ① 未回补登记表（口径来源，不裁剪）
var array<float> oLevel = array.new<float>()
var array<int>   oDir   = array.new<int>()        // +1 向上缺口 / -1 向下缺口
var array<int>   oBorn  = array.new<int>()        // 诞生 K 的 bar_index

// ② 绘图 / 历史表（可裁剪）
var array<line>  aLine   = array.new<line>()
var array<label> aLbl    = array.new<label>()
var array<float> aLevel  = array.new<float>()     // 缺口位（被套方打平价）
var array<int>   aDir    = array.new<int>()       // +1 向上缺口 / -1 向下缺口
var array<int>   aBorn   = array.new<int>()       // 触发 K 的 bar_index
var array<int>   aBroken = array.new<int>()       // 被突破 K 的 bar_index
var array<int>   aTime   = array.new<int>()
var array<float> aDepth  = array.new<float>()     // 破位深度（tick）
var array<bool>  aFilled = array.new<bool>()
var array<int>   aFillBar = array.new<int>()      // -1 = 未回补
var array<float> aMM     = array.new<float>()

var array<box>   microBox = array.new<box>()

var array<line>  mmLines  = array.new<line>()
var array<label> mmLabels = array.new<label>()


// ═══════════════ 状态：最近一根反向实体 K 线的极值 ═══════════════
// 向下缺口要参考「最近的阳线」的低点；向上缺口要参考「最近的阴线」的高点。
// ⚠ 不设 used 标志：同一价位可以被反复突破，去重靠「该价位是否已有未回补缺口」。

var float lastBullLow  = na
var int   lastBullBar  = na

var float lastBearHigh = na
var int   lastBearBar  = na


// ═════════════ 第一步 · 回补检查（先处理旧缺口，再检测新缺口）═════════════
// 只扫「未回补登记表」（很小）→ 每根成本与图表长度无关。
// 回补判据：引线触及缺口位即算（向上缺口看 low，向下缺口看 high）。
// 放在检测之前 → 新缺口最早在「触发 K 的下一根」才会被判回补，
// 正好对应体系说的「制造出缺口下根 K 就被回补」。

if array.size(oLevel) > 0
    for i = array.size(oLevel) - 1 to 0
        bool  up = array.get(oDir, i) > 0
        float lv = array.get(oLevel, i)
        bool  hit = up ? low <= lv : high >= lv
        if hit
            // 从口径表摘除 —— 该价位就此「让出」，之后再次被反向实体突破 = 一批新的被套方
            array.remove(oLevel, i)
            array.remove(oDir, i)
            array.remove(oBorn, i)

            // 同步改写绘图/历史表中的对应行（按 方向 + 价位 反向定位唯一未回补行）
            if array.size(aLevel) > 0
                for k = array.size(aLevel) - 1 to 0
                    if not array.get(aFilled, k) and array.get(aDir, k) == (up ? 1 : -1) and math.abs(array.get(aLevel, k) - lv) < syminfo.mintick
                        array.set(aFilled, k, true)
                        array.set(aFillBar, k, bar_index)
                        int age = bar_index - array.get(aBorn, k)

                        line cl = array.get(aLine, k)
                        if not na(cl)
                            line.set_color(cl, color.new(filledCol, 55))
                            line.set_style(cl, line.style_dotted)
                            line.set_width(cl, 1)

                        label cb = array.get(aLbl, k)
                        if not na(cb)
                            label.set_text(cb, "✓ 回补 " + str.tostring(age) + " 根")
                            label.set_color(cb, color.new(color.gray, 80))
                            label.set_textcolor(cb, color.new(#455a64, 0))
                        break


// ═════════════════════ 第二步 · 检测新缺口 ═════════════════════

bool isBull = close > open
bool isBear = close < open

float thr = minDepthT * syminfo.mintick

// ta.* 必须在全局作用域无条件求值，循环状态才不会漏根
float rngV = ta.highest(high, legLook) - ta.lowest(low, legLook)
float atrV = ta.atr(14)

bool  newUp  = false
bool  newDn  = false
float lvl    = na
int   broken = na

// 去重规则（与 _zpa_gap_ref.py 的 pine_equivalent 逐行一致）：
//   同方向 + 同价位上若已有【未回补】缺口 → 不另记（那是同一批被套方）。
//   缺口一旦回补就「让出」该价位，之后再次被反向实体突破 = 一批新的被套方。
//   ⚠ 不能设 used 标志：同一个极值可能被不同 K 线各突破一次（各自成立）。
//   只扫未回补登记表（很小），所以这段没有历史长度成本。
alreadyOpen(int d, float p) =>
    bool found = false
    if array.size(oLevel) > 0
        for i = array.size(oLevel) - 1 to 0
            if array.get(oDir, i) == d and math.abs(array.get(oLevel, i) - p) < thr
                found := true
                break
    found

// 向下缺口：阴线的实体（收盘价）跌破最近一根阳线的最低价
if isBear and not na(lastBullLow) and close < lastBullLow - thr and not alreadyOpen(-1, lastBullLow)
    newDn  := true
    lvl    := lastBullLow
    broken := lastBullBar

// 向上缺口：阳线的实体（收盘价）突破最近一根阴线的最高价
if isBull and not na(lastBearHigh) and close > lastBearHigh + thr and not alreadyOpen(1, lastBearHigh)
    newUp  := true
    lvl    := lastBearHigh
    broken := lastBearBar

// 状态更新必须放在检测之后（检测用的是「之前」的最近反向 K 线）
if isBull
    lastBullLow := low
    lastBullBar := bar_index
if isBear
    lastBearHigh := high
    lastBearBar := bar_index

if newUp or newDn
    int   dir   = newUp ? 1 : -1
    float depth = math.abs(close - lvl) / syminfo.mintick

    // 测量缺口 → MM 投影：缺口位 ± 缺口前一段的波段高度
    float mmTgt = rngV > 0 ? (dir > 0 ? lvl + rngV : lvl - rngV) : na

    // ① 口径表（不裁剪）
    array.push(oLevel, lvl)
    array.push(oDir, dir)
    array.push(oBorn, bar_index)

    // ② 绘图 / 历史表（可裁剪）
    array.push(aLevel, lvl)
    array.push(aDir, dir)
    array.push(aBorn, bar_index)
    array.push(aBroken, broken)
    array.push(aTime, time)
    array.push(aDepth, depth)
    array.push(aFilled, false)
    array.push(aFillBar, -1)
    array.push(aMM, mmTgt)

    color col = dir > 0 ? upCol : dnCol
    line nl = line.new(broken, lvl, bar_index + extendBars, lvl, color = color.new(col, 0), width = 2, style = line.style_solid)
    array.push(aLine, nl)

    label lb = na
    if showTag
        string txt = (dir > 0 ? "▲ 向上缺口 " : "▼ 向下缺口 ") + str.tostring(lvl, format.mintick) + "　破位 " + str.tostring(depth, "#") + "t"
        lb := label.new(bar_index + extendBars, lvl, text = txt, style = label.style_label_left, color = color.new(col, 30), textcolor = color.new(color.white, 0), size = size.tiny)
    array.push(aLbl, lb)

    // 容量裁剪：只裁【绘图/历史表】。
    // ⚠ 口径表（oLevel/oDir/oBorn）绝不参与裁剪 —— 渲染容量不得改变口径。
    if array.size(aLevel) > keepMax
        line  oln = array.shift(aLine)
        if not na(oln)
            line.delete(oln)
        label olb = array.shift(aLbl)
        if not na(olb)
            label.delete(olb)
        array.shift(aLevel)
        array.shift(aDir)
        array.shift(aBorn)
        array.shift(aBroken)
        array.shift(aTime)
        array.shift(aDepth)
        array.shift(aFilled)
        array.shift(aFillBar)
        array.shift(aMM)


// ═════════════════ 微缺口（bar[i-1] 与 bar[i+1]，隔一根）═════════════════
// 无未来函数：当前根为 i+1 时回头比较 i-1 与 i+1。

bool  microNow = false
float mLo = na
float mHi = na
int   mDir = 0

if bar_index >= 2
    if high[2] < low and (low - high[2]) <= microAtr * nz(atrV, syminfo.mintick)
        microNow := true
        mDir := 1
        mLo  := high[2]
        mHi  := low
    else if high < low[2] and (low[2] - high) <= microAtr * nz(atrV, syminfo.mintick)
        microNow := true
        mDir := -1
        mLo  := high
        mHi  := low[2]

if microNow and showMicro
    box mb = box.new(bar_index - 2, mHi, bar_index + extendBars, mLo, bgcolor = color.new(mDir > 0 ? upCol : dnCol, 90), border_color = color.new(color.gray, 70), border_style = line.style_dotted, border_width = 1)
    array.push(microBox, mb)
    if array.size(microBox) > keepMax
        box old = array.shift(microBox)
        if not na(old)
            box.delete(old)


// ═════════════════ 第三步 · 状态统计 / 标签维护 ═════════════════

// 「未回补」是口径量 → 必须取自【不裁剪】的口径表，不能被 keepMax 影响
int nOpen   = array.size(oLevel)
int nOpenUp = 0
int nOpenDn = 0
if array.size(oDir) > 0
    for i = 0 to array.size(oDir) - 1
        if array.get(oDir, i) > 0
            nOpenUp += 1
        else
            nOpenDn += 1

// 「已回补 / 快速回补」是历史统计量 → 取自被裁剪的绘图/历史表（面板会注明范围）
int nFilledAll = 0
int nFakeAll   = 0
int lastOpenIx = -1

if array.size(aLevel) > 0
    int nst = array.size(aLevel)
    for i = 0 to nst - 1
        if array.get(aFilled, i)
            nFilledAll += 1
            if (array.get(aFillBar, i) - array.get(aBorn, i)) <= fakeBars
                nFakeAll += 1
    for i = nst - 1 to 0
        if not array.get(aFilled, i)
            lastOpenIx := i
            break

// 未回补缺口向右延伸
if barstate.islast and array.size(aLevel) > 0
    int n2 = array.size(aLevel)
    for i = 0 to n2 - 1
        if not array.get(aFilled, i) and not na(array.get(aLine, i))
            line.set_x2(array.get(aLine, i), bar_index + extendBars)

// 「有跟随」确认 → 标签改写为「突破型」
if array.size(aLbl) > 0
    int n3 = array.size(aLbl)
    for i = 0 to n3 - 1
        if not array.get(aFilled, i) and not na(array.get(aLbl, i))
            int age = bar_index - array.get(aBorn, i)
            if age == followBars
                label.set_text(array.get(aLbl, i), "✔ 突破型（已敞开 " + str.tostring(followBars) + " 根）")
                label.set_color(array.get(aLbl, i), color.new(array.get(aDir, i) > 0 ? upCol : dnCol, 15))

// 高亮「最后一个缺口」
if markLast and barstate.islast and lastOpenIx >= 0 and not na(array.get(aLine, lastOpenIx))
    line.set_color(array.get(aLine, lastOpenIx), color.new(#ff9800, 0))
    line.set_width(array.get(aLine, lastOpenIx), 3)


// ═════════════════════ 第四步 · MM 目标线（最后 bar 重绘）═════════════════════

if barstate.islast
    int nm = array.size(mmLines)
    if nm > 0
        for i = 0 to nm - 1
            line.delete(array.get(mmLines, i))
        array.clear(mmLines)
    int nl2 = array.size(mmLabels)
    if nl2 > 0
        for i = 0 to nl2 - 1
            label.delete(array.get(mmLabels, i))
        array.clear(mmLabels)

    if showMM and array.size(aLevel) > 0
        int shown = 0
        int nmm = array.size(aLevel)
        for i = nmm - 1 to 0
            if shown >= mmMaxShow
                break
            if not array.get(aFilled, i) and not na(array.get(aMM, i))
                float y  = array.get(aMM, i)
                int   x1 = math.max(0, array.get(aBroken, i))
                line lm = line.new(x1, y, bar_index + extendBars, y, color = color.new(#ff9800, 25), width = 1, style = line.style_dashed)
                array.push(mmLines, lm)
                label lb2 = label.new(bar_index + extendBars, y, text = "MM 目标 " + str.tostring(y, format.mintick), style = label.style_label_left, color = color.new(#ff9800, 70), textcolor = color.new(color.white, 0), size = size.tiny)
                array.push(mmLabels, lb2)
                shown += 1


// ═════════════════════════════ 缺口清单面板 ═════════════════════════════

var table pnlG = table.new(position.top_right, 5, 24, border_width = 1, frame_width = 1, frame_color = color.new(color.gray, 45))

if showPanel and barstate.islast
    table.clear(pnlG, 0, 0, 4, 23)
    table.merge_cells(pnlG, 0, 0, 4, 0)
    table.cell(pnlG, 0, 0, "Zpa 02 · 突破型缺口（缺口位 = 被套方打平价）", text_color = color.white, bgcolor = color.new(#37474f, 0), text_size = size.small, text_halign = text.align_center)

    array<string> heads = array.from("时间", "方向", "缺口位", "破位", "状态")
    for c = 0 to 4
        table.cell(pnlG, c, 1, array.get(heads, c), text_color = color.new(#263238, 0), bgcolor = color.new(#eceff1, 0), text_size = size.tiny, text_halign = text.align_left)

    int np = array.size(aLevel)
    int r = 2
    if np > 0
        for i = np - 1 to 0
            if r > panelRows + 1
                break
            bool up = array.get(aDir, i) > 0
            bool fl = array.get(aFilled, i)
            int  age = fl ? array.get(aFillBar, i) - array.get(aBorn, i) : bar_index - array.get(aBorn, i)
            string st = fl ? (age <= fakeBars ? "✕ 假突破" : "回补 " + str.tostring(age) + " 根") : (age >= followBars ? "✔ 敞开 " + str.tostring(age) + " 根" : "待跟随")
            if i == lastOpenIx and not fl
                st := "★ " + st
            color rowBg = fl ? color.new(#fafafa, 0) : color.new(up ? upCol : dnCol, 86)
            color txtC  = color.new(#263238, 0)

            table.cell(pnlG, 0, r, str.format_time(array.get(aTime, i), "MM-dd HH:mm"), text_color = txtC, bgcolor = rowBg, text_size = size.tiny, text_halign = text.align_left)
            table.cell(pnlG, 1, r, up ? "▲ 上" : "▼ 下", text_color = txtC, bgcolor = rowBg, text_size = size.tiny, text_halign = text.align_left)
            table.cell(pnlG, 2, r, str.tostring(array.get(aLevel, i), format.mintick), text_color = txtC, bgcolor = rowBg, text_size = size.tiny, text_halign = text.align_left)
            table.cell(pnlG, 3, r, str.tostring(array.get(aDepth, i), "#") + "t", text_color = txtC, bgcolor = rowBg, text_size = size.tiny, text_halign = text.align_left)
            table.cell(pnlG, 4, r, st, text_color = txtC, bgcolor = rowBg, text_size = size.tiny, text_halign = text.align_left)
            r += 1

    int sumRow = math.min(r, 23)
    table.merge_cells(pnlG, 0, sumRow, 4, sumRow)
    table.cell(pnlG, 0, sumRow, "未回补 " + str.tostring(nOpen) + "（向上 " + str.tostring(nOpenUp) + " ／ 向下 " + str.tostring(nOpenDn) + "）　保留 " + str.tostring(array.size(aLevel)) + " 条中已回补 " + str.tostring(nFilledAll) + "　其中快速回补 " + str.tostring(nFakeAll) + " → 越多越是震荡", text_color = color.new(#263238, 0), bgcolor = color.new(#fff8e1, 0), text_size = size.tiny, text_halign = text.align_left)


// ═════════════════════════════ 告警 ═════════════════════════════

alertcondition(newUp, "Zpa 向上突破型缺口", "出现向上突破型缺口：阴线高点被阳线实体突破")
alertcondition(newDn, "Zpa 向下突破型缺口", "出现向下突破型缺口：阳线低点被阴线实体跌破")
alertcondition(array.size(aLevel) > 0 and lastOpenIx >= 0 and array.get(aBorn, lastOpenIx) == bar_index, "Zpa 新未回补缺口", "出现新的未回补缺口")
alertcondition(nOpen == 0 and nOpen[1] > 0, "Zpa 缺口全部回补", "所有缺口都已回补 → 趋势转弱 / 震荡区间特征")
