//@version=6
// ═══════════════════════════════════════════════════════════════════════════════
//  Zpa 04 · 入场 Setup 与信号自检
//  ──────────────────────────────────────────────────────────────────────────────
//  依据：「Z说交易」概念库 05-入场Setup与形态 / 06-止损与目标位管理
//
//  体系铁律（本脚本强制执行）：进场至少要「一个支撑阻力 + 一个形态」两个理由
//  叠加，理由少于两个则不做，宁可错过。因此本脚本不会因为单一条件就出信号。
//
//  实现的 Setup：
//    · M2B / M2S  —— 趋势中两段式回调 / 反弹到 EMA20 附近，出现信号 K
//    · 二次回补缺口失败 —— 缺口旁两次测试都未能回补，被套方力竭，顺势入场
//    · II / OI    —— 内包内包 / 外包内包（小级别突破模式）
//    · 信号 K 质量 —— 内包 K、长影反转 K、饱满实体趋势 K
//
//  缺口口径（体系，非跳空）：缺口 = 被反向实体（收盘价）突破的那根 K 线的极值，
//  是一个【价位】—— 向下缺口取阳线最低价、向上缺口取阴线最高价，即被套方打平价。
//
//  自检（体系 §10 入场信号质量的自检技巧）：
//    · 入场 K 及其跟随是否制造微缺口？没制造 → 该入场点有概率不是最终拐点
//    · 微缺口的体系几何 = 前一根与后一根之间、中间隔一根形成的微型缺口
//      （无未来函数 → 当根作为「后一根」，与前前根 high[2]/low[2] 比较）
//
//  ⚠ 重要：「两段式（two legs）」在脚本里只能做近似识别，任何信号都必须由人工
//     在图上确认结构后再执行。本脚本是提示器，不是交易系统，不构成投资建议。
// ═══════════════════════════════════════════════════════════════════════════════
indicator("Zpa 04 · Setup 信号与自检", "Zpa Setups", overlay = true, max_labels_count = 500, max_bars_back = 1000)


// ═══════════════════════════════════ 参数 ═══════════════════════════════════

string G1 = "背景与均线"
int    emaLen    = input.int(20, "EMA 长度（体系常用 EMA20）", minval = 5, maxval = 200, group = G1)
int    slopeLen  = input.int(5, "EMA 斜率回看根数", minval = 1, maxval = 50, group = G1)
float  touchAtr  = input.float(0.35, "回踩均线的容差（ATR ×）", minval = 0.05, maxval = 2.0, step = 0.05, group = G1)
int    pullLook  = input.int(30, "确认「曾离开均线」的回看根数", minval = 5, maxval = 200, group = G1)

string G2 = "信号 K 判定"
float  pinRatio  = input.float(0.45, "反转 K 影线占比阈值", minval = 0.20, maxval = 0.90, step = 0.05, group = G2, tooltip = "影线长度 ÷ 整根振幅。体系：长下影阳线 / 长上影阴线（Pin Bar）是容易形成缺口的 K 线类型。")
float  bodyRatio = input.float(0.50, "趋势 K 实体占比阈值", minval = 0.20, maxval = 0.95, step = 0.05, group = G2)

string G3 = "二次回补缺口失败"
float  gapTouch  = input.float(0.25, "「接近缺口」的容差（ATR ×）", minval = 0.05, maxval = 1.0, step = 0.05, group = G3)
float  gapSame   = input.float(0.50, "两次测试低/高点的接近容差（ATR ×）", minval = 0.05, maxval = 2.0, step = 0.05, group = G3, tooltip = "体系：缺口旁出现两次非常接近缺口的双顶/双底、都没有成功回补，此时出现好的信号 K → 非常好的顺势机会。")
int    retestWin = input.int(25, "两次测试的最大间隔（根）", minval = 3, maxval = 100, group = G3)

string G4 = "微缺口自检"
bool   useMicro  = input.bool(true, "在信号上标注微缺口自检结果", group = G4)
float  microAtrM = input.float(0.30, "微缺口宽度上限（ATR ×）", minval = 0.05, maxval = 2.0, step = 0.05, group = G4, tooltip = "体系：前一根与后一根之间、中间隔一根形成的微型缺口。只把「小」的算微缺口，超过该宽度视为普通缺口。")

string G5 = "显示"
bool   showLabel = input.bool(true, "在图上标注信号", group = G5)
int    maxLabels = input.int(60, "最多保留信号标注数", minval = 5, maxval = 300, group = G5)
bool   showEma   = input.bool(true, "显示 EMA20", group = G5)
bool   showPanel = input.bool(true, "显示自检面板", group = G5)


// ═══════════════════════════ 背景（轻量二元决策）═══════════════════════════

float ema   = ta.ema(close, emaLen)
float atrV  = ta.atr(14)
float slope = ema - ema[slopeLen]

bool upCtx = slope > 0 and close > ema
bool dnCtx = slope < 0 and close < ema

float touchBand = touchAtr * atrV
bool  nearEma   = math.abs(close - ema) <= touchBand or (low <= ema + touchBand and high >= ema - touchBand)

// 「曾离开均线」= 窗口内价格曾显著偏离 EMA20（说明刚经历一段推进）
bool wasExtUp = ta.highest(high, pullLook) > ema + 1.0 * atrV
bool wasExtDn = ta.lowest(low, pullLook) < ema - 1.0 * atrV


// ═══════════════════════════ 信号 K 质量 ═══════════════════════════

float rng    = high - low
float bodyTop = math.max(open, close)
float bodyBot = math.min(open, close)
float safeRng = math.max(rng, syminfo.mintick)

bool upWickLong = (high - bodyTop) / safeRng >= pinRatio
bool dnWickLong = (bodyBot - low) / safeRng >= pinRatio

bool inside  = high <= high[1] and low >= low[1]
bool outside = high >= high[1] and low <= low[1]

bool bullPin  = close > open and dnWickLong
bool bearPin  = close < open and upWickLong
bool bullBody = close > open and (close - open) / safeRng >= bodyRatio
bool bearBody = close < open and (open - close) / safeRng >= bodyRatio

bool bullSignalBar = inside or bullPin or bullBody
bool bearSignalBar = inside or bearPin or bearBody

// II / OI（内包内包 / 外包内包）
bool ii = inside and inside[1]
bool oi = outside[1] and inside
bool iioi = ii and inside[2]


// ══════════════════ 最近一个未回补的突破型缺口 ══════════════════
// 体系口径：缺口 = 被反向实体（收盘价）突破的那根 K 线的极值，
// 是一个【价位】而不是区间 ——
//   向下缺口 = 阴线实体跌破的那根【阳线的最低价】（被套多头的打平价）
//   向上缺口 = 阳线实体突破的那根【阴线的最高价】（被套空头的打平价）
var float zLv     = na        // 缺口位
var int   zDir    = 0         // +1 向上缺口 / -1 向下缺口
var bool  zOpen   = false
var int   t1Bar   = na        // 第一次测试缺口的 bar
var float t1Px    = na        // 第一次测试的极值

var float zLastBullLow  = na
var float zLastBearHigh = na

// 未回补缺口位登记表（口径来源，不裁剪；只存未回补，回补即移除 → 天然很小）
// 它同时充当去重表：同方向 + 同价位上已有未回补缺口 → 不另记。
var array<float> zOLv  = array.new<float>()
var array<int>   zODir = array.new<int>()

// (1) 旧缺口是否被回补（引线触及缺口位即算）—— 顺带维护去重表
if array.size(zOLv) > 0
    for i = array.size(zOLv) - 1 to 0
        bool  up = array.get(zODir, i) > 0
        float lv = array.get(zOLv, i)
        bool  hit = up ? low <= lv : high >= lv
        if hit
            if zOpen and array.get(zODir, i) == zDir and math.abs(lv - zLv) < syminfo.mintick
                zOpen := false
            array.remove(zOLv, i)
            array.remove(zODir, i)

// (2) 新缺口（覆盖旧的，并重置测试计数）
bool zBull = close > open
bool zBear = close < open

// 去重规则（与 _zpa_gap_ref.py 一致）：同方向 + 同价位上若已有【未回补】缺口 →
// 不另记（那是同一批被套方）；缺口一旦回补就「让出」该价位。
zGapOpen(int d, float p) =>
    bool found = false
    if array.size(zOLv) > 0
        for i = array.size(zOLv) - 1 to 0
            if array.get(zODir, i) == d and math.abs(array.get(zOLv, i) - p) < syminfo.mintick
                found := true
                break
    found

if zBear and not na(zLastBullLow) and close < zLastBullLow - syminfo.mintick and not zGapOpen(-1, zLastBullLow)
    zLv   := zLastBullLow
    zDir  := -1
    zOpen := true
    t1Bar := na
    t1Px  := na
    array.push(zOLv, zLastBullLow)
    array.push(zODir, -1)
else if zBull and not na(zLastBearHigh) and close > zLastBearHigh + syminfo.mintick and not zGapOpen(1, zLastBearHigh)
    zLv   := zLastBearHigh
    zDir  := 1
    zOpen := true
    t1Bar := na
    t1Px  := na
    array.push(zOLv, zLastBearHigh)
    array.push(zODir, 1)

if zBull
    zLastBullLow := low
if zBear
    zLastBearHigh := high

float gapBand  = gapTouch * nz(atrV, syminfo.mintick * 4)
float sameBand = gapSame * nz(atrV, syminfo.mintick * 4)

// 测试缺口但未回补：向下缺口 → 价格从下方反弹接近缺口位；向上缺口 → 从上方回落接近
bool testUp = zOpen and zDir > 0 and low <= zLv + gapBand and low > zLv
bool testDn = zOpen and zDir < 0 and high >= zLv - gapBand and high < zLv

bool secondFailUp = false
bool secondFailDn = false

if testUp
    if not na(t1Bar) and bar_index - t1Bar >= 2 and bar_index - t1Bar <= retestWin and math.abs(low - t1Px) <= sameBand
        secondFailUp := true
        t1Bar := na
        t1Px  := na
    else
        t1Bar := bar_index
        t1Px  := low

if testDn
    if not na(t1Bar) and bar_index - t1Bar >= 2 and bar_index - t1Bar <= retestWin and math.abs(high - t1Px) <= sameBand
        secondFailDn := true
        t1Bar := na
        t1Px  := na
    else
        t1Bar := bar_index
        t1Px  := high


// ═══════════════════════════ 微缺口自检 ═══════════════════════════
// 体系：前一根 K 线和后一根 K 线、中间一根 K 隔开，三根 K 线中间的这个微型缺口。
// 无未来函数 → 当根作为「后一根」，与前前根 high[2]/low[2] 比较。

bool microUp   = bar_index >= 2 and low > high[2]      // 隔一根的向上微缺口
bool microDn   = bar_index >= 2 and high < low[2]      // 隔一根的向下微缺口
bool hasGapNow = microUp or microDn

float gapW = microUp ? low - high[2] : microDn ? low[2] - high : 0.0
bool  isMicroGap = hasGapNow and gapW <= microAtrM * nz(atrV, syminfo.mintick)


// ═══════════════════════════ 组装 Setup（理由分类）═══════════════════════════

// —— 支撑阻力类理由 ——
bool lvlEma = nearEma
bool lvlGap = zOpen and (zDir > 0 ? low <= zLv + gapBand and low > zLv : high >= zLv - gapBand and high < zLv)

// —— 形态类理由 ——
bool formM2b      = upCtx and wasExtUp and nearEma and bullSignalBar
bool formM2s      = dnCtx and wasExtDn and nearEma and bearSignalBar
bool formGapFailU = secondFailUp and bullSignalBar
bool formGapFailD = secondFailDn and bearSignalBar
bool formII       = ii and nearEma
bool formOI       = oi and nearEma

bool longTrig  = formM2b or formGapFailU or (formII and upCtx) or (formOI and upCtx)
bool shortTrig = formM2s or formGapFailD or (formII and dnCtx) or (formOI and dnCtx)

// 体系铁律：至少「一个支撑阻力 + 一个形态」
bool lvlOKLong  = lvlEma or lvlGap
bool lvlOKShort = lvlEma or lvlGap

bool sigLong  = longTrig and lvlOKLong
bool sigShort = shortTrig and lvlOKShort

mkReason(bool lvlE, bool lvlG, bool fM2b, bool fM2s, bool fGU, bool fGD, bool fII, bool fOI) =>
    string s = ""
    int    n = 0
    if lvlE
        s := s + (n > 0 ? "｜" : "") + "支撑阻力:EMA20"
        n += 1
    if lvlG
        s := s + (n > 0 ? "｜" : "") + "支撑阻力:缺口位"
        n += 1
    if fM2b
        s := s + (n > 0 ? "｜" : "") + "形态:M2B 两段式回调"
        n += 1
    if fM2s
        s := s + (n > 0 ? "｜" : "") + "形态:M2S 两段式反弹"
        n += 1
    if fGU
        s := s + (n > 0 ? "｜" : "") + "形态:二次回补缺口失败(多)"
        n += 1
    if fGD
        s := s + (n > 0 ? "｜" : "") + "形态:二次回补缺口失败(空)"
        n += 1
    if fII
        s := s + (n > 0 ? "｜" : "") + "形态:II 内包内包"
        n += 1
    if fOI
        s := s + (n > 0 ? "｜" : "") + "形态:OI 外包内包"
        n += 1
    [s, n]

[longTxt, longNum]  = mkReason(lvlEma, lvlGap, formM2b, false, formGapFailU, false, formII, formOI)
[shortTxt, shortNum] = mkReason(lvlEma, lvlGap, false, formM2s, false, formGapFailD, formII, formOI)


// ═══════════════════════════════ 绘图与标注 ═══════════════════════════════

plot(showEma ? ema : na, title = "EMA20", color = color.new(#2962ff, 0), linewidth = 2)

var array<label> sigLbls = array.new<label>()

float atrSafe = nz(atrV, math.max(high - low, syminfo.mintick * 4))

if showLabel and (sigLong or sigShort)
    string microTxt = useMicro ? (isMicroGap ? "微缺口 ✓" : "无微缺口 ⚠") : ""
    string head     = (sigLong ? "▲ 做多候选" : "▼ 做空候选") + " · 理由 " + str.tostring(sigLong ? longNum : shortNum)
    string body     = sigLong ? longTxt : shortTxt
    string txt      = head + "\n" + body + (microTxt == "" ? "" : "\n" + microTxt)
    label nl = label.new(bar_index, sigLong ? low - atrSafe * 0.6 : high + atrSafe * 0.6, text = txt, style = sigLong ? label.style_label_up : label.style_label_down, color = sigLong ? color.new(#26a69a, 12) : color.new(#ef5350, 12), textcolor = color.new(color.white, 0), size = size.tiny)
    array.push(sigLbls, nl)
    if array.size(sigLbls) > maxLabels
        label old = array.shift(sigLbls)
        if not na(old)
            label.delete(old)

plotshape(formII and not lvlEma, title = "II 内包内包", style = shape.diamond, location = location.abovebar, color = color.new(#ff9800, 20), size = size.tiny)
plotshape(secondFailUp, title = "二次回补缺口失败(多)", style = shape.triangleup, location = location.belowbar, color = color.new(#26a69a, 0), size = size.small)
plotshape(secondFailDn, title = "二次回补缺口失败(空)", style = shape.triangledown, location = location.abovebar, color = color.new(#ef5350, 0), size = size.small)

// 微缺口标记
plotshape(useMicro and hasGapNow, title = "当根制造微缺口（隔一根）", style = shape.circle, location = location.top, color = color.new(isMicroGap ? #26c6da : #ffca28, 10), size = size.tiny)

bgcolor(sigLong ? color.new(#26a69a, 90) : sigShort ? color.new(#ef5350, 90) : na, title = "Setup 底色")


// ═══════════════════════════════ 自检面板 ═══════════════════════════════

var table pnlS = table.new(position.bottom_right, 3, 10, border_width = 1, frame_width = 1, frame_color = color.new(color.gray, 45))

if showPanel and barstate.islast
    table.clear(pnlS, 0, 0, 2, 9)
    table.merge_cells(pnlS, 0, 0, 2, 0)
    table.cell(pnlS, 0, 0, "Zpa 04 · Setup 自检", text_color = color.white, bgcolor = color.new(#37474f, 0), text_size = size.small, text_halign = text.align_center)

    color kbg = color.new(#eceff1, 0)
    color vbg = color.new(#ffffff, 0)
    color txt = color.new(#263238, 0)

    table.cell(pnlS, 0, 1, "背景", text_color = txt, bgcolor = kbg, text_size = size.small, text_halign = text.align_left)
    table.merge_cells(pnlS, 1, 1, 2, 1)
    table.cell(pnlS, 1, 1, upCtx ? "向上（EMA20 上行且价在上方）" : dnCtx ? "向下（EMA20 下行且价在下方）" : "不明确 → 按体系应观望", text_color = txt, bgcolor = upCtx ? color.new(#26a69a, 82) : dnCtx ? color.new(#ef5350, 82) : color.new(#f4a300, 80), text_size = size.small, text_halign = text.align_left)

    table.cell(pnlS, 0, 2, "支撑阻力", text_color = txt, bgcolor = kbg, text_size = size.small, text_halign = text.align_left)
    table.merge_cells(pnlS, 1, 2, 2, 2)
    table.cell(pnlS, 1, 2, (lvlEma ? "EMA20 ✓" : "EMA20 ✗") + "　" + (lvlGap ? "缺口位 ✓" : "缺口位 ✗") + "　（至少需 1 个）", text_color = txt, bgcolor = vbg, text_size = size.small, text_halign = text.align_left)

    table.cell(pnlS, 0, 3, "形态", text_color = txt, bgcolor = kbg, text_size = size.small, text_halign = text.align_left)
    table.merge_cells(pnlS, 1, 3, 2, 3)
    table.cell(pnlS, 1, 3, "M2B " + (formM2b ? "✓" : "✗") + "　M2S " + (formM2s ? "✓" : "✗") + "　缺口失败 " + (formGapFailU ? "多✓" : formGapFailD ? "空✓" : "✗") + "　II " + (formII ? "✓" : "✗") + " OI " + (formOI ? "✓" : "✗"), text_color = txt, bgcolor = vbg, text_size = size.small, text_halign = text.align_left)

    table.cell(pnlS, 0, 4, "缺口", text_color = txt, bgcolor = kbg, text_size = size.small, text_halign = text.align_left)
    table.merge_cells(pnlS, 1, 4, 2, 4)
    table.cell(pnlS, 1, 4, zOpen ? ((zDir > 0 ? "向上" : "向下") + " 未回补 · 缺口位 " + str.tostring(zLv, format.mintick) + "（被套方打平价）") : "最近缺口已回补", text_color = txt, bgcolor = vbg, text_size = size.small, text_halign = text.align_left)

    table.cell(pnlS, 0, 5, "微缺口自检", text_color = txt, bgcolor = kbg, text_size = size.small, text_halign = text.align_left)
    table.merge_cells(pnlS, 1, 5, 2, 5)
    table.cell(pnlS, 1, 5, hasGapNow ? (isMicroGap ? "当根制造微缺口 ✓ 宽度 " + str.tostring(gapW, format.mintick) + "（机构快速推进的迹象）" : "当根有隔根缺口，但偏宽、不算微缺口") : "当根无微缺口 → 有概率不是最终拐点 ⚠", text_color = txt, bgcolor = vbg, text_size = size.small, text_halign = text.align_left)

    table.merge_cells(pnlS, 0, 6, 2, 6)
    table.cell(pnlS, 0, 6, sigLong ? "▲ 满足「1 支撑阻力 + 1 形态」：做多候选" : sigShort ? "▼ 满足「1 支撑阻力 + 1 形态」：做空候选" : "理由不足 2 个 → 按体系铁律：不做，宁可错过", text_color = color.white, bgcolor = sigLong ? color.new(#26a69a, 0) : sigShort ? color.new(#ef5350, 0) : color.new(#78909c, 0), text_size = size.small, text_halign = text.align_left)

    table.merge_cells(pnlS, 0, 7, 2, 7)
    table.cell(pnlS, 0, 7, sigLong ? longTxt : sigShort ? shortTxt : "—", text_color = txt, bgcolor = color.new(#f5f5f5, 0), text_size = size.small, text_halign = text.align_left)

    table.merge_cells(pnlS, 0, 8, 2, 8)
    table.cell(pnlS, 0, 8, "止损须与入场逻辑匹配（回调入场放趋势起点/前重要低点；回补缺口后可用信号 K 极值）", text_color = color.new(#546e7a, 0), bgcolor = color.new(#fafafa, 0), text_size = size.small, text_halign = text.align_left)

    table.merge_cells(pnlS, 0, 9, 2, 9)
    table.cell(pnlS, 0, 9, "两段式结构为脚本近似识别，须人工在图上确认后执行 · 非投资建议", text_color = color.new(#78909c, 0), bgcolor = color.new(#fafafa, 0), text_size = size.small, text_halign = text.align_left)


// ═════════════════════════════ 告警 ═════════════════════════════

alertcondition(sigLong, "Zpa 做多 Setup", "满足「1 支撑阻力 + 1 形态」的做多候选（须人工确认结构）")
