//@version=6
// ═══════════════════════════════════════════════════════════════════════════════
//  Zpa 01 · 市场背景（二元决策 + 通道划分）
//  ──────────────────────────────────────────────────────────────────────────────
//  依据：「Z说交易」价格行为体系 ＋ Al Brooks PA 的通道 / 趋势线框架
//        · 概念库 01-市场背景与二元决策（二元决策 + 市场周期分级 + 六条证据）
//        · 概念库 02-缺口理论 §4
//        · 概念库 04-趋势恢复与反转逻辑 §4.1（MTR 的两个条件）
//        · docs/蒋老师/通道转区间、通道实解、大背景下市场周期演变、区间解析
//        · docs/蒋老师/PA不是形态学市场周期最重要【识别重要高低点】
//
//  体系原文：「判断当前市场是【趋势】还是【震荡区间】，是价格行为交易中最基础、
//  最关键、第一步且唯一必须做的基础决策。」
//    · 趋势 → 顺势交易（再分 突破/急速 · 窄通道(强趋势) · 宽通道(弱趋势)）
//    · 震荡 → 高抛低吸、压注突破失败、做反转
//
//  本脚本做两件事：
//    ① 背景「定性」：把六条判断证据 + 通道证据逐条量化，取值全部公开在面板里；
//    ② 背景「划分」：画出趋势线 / 通道线 / 重要高低点 / 通道过充 / 趋势线破位 /
//       通道 MM 一倍目标，并把行情切成一段段【背景带】。
//
//  ── 趋势线 / 通道线怎么画（体系原话）────────────────────────────────────────
//  「顺着走势，发现有一个通道就画出来；发现更高高点或更低低点，连接即可。」
//  「通道由两个点画出第三个点；通道被强势跌破，可能代表区间的形成。」
//    → 趋势线 = 最近两个同向枢轴（上涨取更高的低点、下跌取更低的高点）；
//      通道线 = 过 [两点区间] 内对面那个极值、与趋势线平行的一条线。
//
//  ⚠ 趋势线不是信号：「趋势线非常的多，主要我们需要等待价格对这个趋势线和通道线
//     进行测试之后出现反应，我们才能去进场，不能去盲目地预判那个支撑阻力会生效。」
//     → 本脚本只标位置，不产生任何买卖信号。
//
//  证据二（缺口）用的是体系口径，**不是跳空**：被反向实体（收盘价）突破的那根
//  K 线的极值就是缺口位 —— 向下缺口取阳线最低价、向上缺口取阴线最高价。
//  该价位即「被套方打平离场」的位置。详见 Zpa 02。
//
//  ⚠ 免责：量化口径是工程近似，结论需人工确认，不构成投资建议。
// ═══════════════════════════════════════════════════════════════════════════════
indicator("Zpa 01 · 市场背景（二元决策 + 通道划分）", "Zpa Context", overlay = true, max_bars_back = 1000, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)


// ═══════════════════════════════════ 参数 ═══════════════════════════════════

string G1 = "① 波段结构（证据一 · 突破左边波段高低点）"
int    pvK      = input.int(3, "分形左右宽度 K", minval = 1, maxval = 10, group = G1, tooltip = "确认一个波段高低点，需要其左右各 K 根 K 线都不超过它。K 越大，波段越少、越显著。趋势线也用同一组枢轴。")
int    structN  = input.int(4, "结构评估所用波段数", minval = 2, maxval = 8, group = G1, tooltip = "用最近 N 个高点与 N 个低点的递增/递减比例判断结构方向。")

string G2 = "② 缺口（证据二 · 体系核心，70% 与缺口相关）"
bool   useGap   = input.bool(true, "把「缺口是否敞开」计入评分", group = G2)
int    gapLook  = input.int(100, "缺口统计窗口（根）", minval = 20, maxval = 500, group = G2, tooltip = "只统计最近该根数内产生的缺口。体系：缺口可以判断趋势强度、方向、目标位。")
int    fastBars = input.int(2, "「快速回补」= 几根内", minval = 1, maxval = 30, group = G2, tooltip = "体系：制造出缺口、下根 K 就被回补、无法长时间敞开 → 假突破 / 突破失败，弱趋势或震荡。")
bool   drawGap  = input.bool(false, "在图上画缺口位（横线）", group = G2, tooltip = "体系口径下缺口是一个「价位」，所以画横线而不是区间箱体。")
color  cGapUp   = input.color(#26a69a, "向上缺口位", group = G2)
color  cGapDn   = input.color(#ef5350, "向下缺口位", group = G2)

string G3 = "③ 回调（证据三 · 持续时间与幅度）"
int    chopLen  = input.int(20, "评估窗口（根）", minval = 5, maxval = 200, group = G3, tooltip = "体系：回调持续超过 20 根 K 线，或回调幅度超过 60%~70%，越接近震荡区间的价格行为。")
float  deepPct  = input.float(0.62, "深回调阈值", minval = 0.30, maxval = 0.90, step = 0.01, group = G3, tooltip = "体系原文给的是 60%~70%，默认取中值 62%。")
int    longBars = input.int(20, "回调过长阈值（根）", minval = 5, maxval = 200, group = G3)

string G4 = "④⑤ K 线质量（逆势跟随 / 顺势实体）"
float  bodyFull = input.float(0.55, "趋势 K 实体饱满阈值", minval = 0.20, maxval = 0.95, step = 0.05, group = G4, tooltip = "实体长度 ÷ 整根振幅。体系：顺势方 K 线应连续、实体饱满、收盘在高位。")
int    oppRunMx = input.int(3, "逆势连续 K 线上限（根）", minval = 2, maxval = 8, group = G4, tooltip = "体系：上涨趋势中出现阴线，若跟随仍是连续 3~4 根好阴线 → 有问题。")
float  dojiBody = input.float(0.30, "十字星/小实体阈值", minval = 0.05, maxval = 0.60, step = 0.05, group = G4)

string G5 = "⑥ 趋势线 / 通道线"
bool   drawChan = input.bool(true, "画趋势线 + 通道线", group = G5)
bool   fillChan = input.bool(true, "通道区间淡色填充", group = G5)
int    keepPiv  = input.int(24, "保留枢轴条数", minval = 6, maxval = 60, group = G5, tooltip = "趋势线从这些枢轴里找「最近的两个同向枢轴」。太小会找不到配对，太大没坏处。")
int    tlMinBars = input.int(8, "趋势线两点的最小间隔（根）", minval = 2, maxval = 60, group = G5, tooltip = "两个取点至少要隔这么多根，否则会画出很陡的假趋势线。")
float  tlTolAtr = input.float(0.15, "判定「有效跌破」的容差（ATR）", minval = 0.0, maxval = 1.0, step = 0.05, group = G5, tooltip = "收盘价要跌破趋势线再减掉这个容差，才算有效跌破 —— 否则一根引线就会把线打掉。")
int    tlExtend = input.int(20, "向右延伸根数", minval = 0, maxval = 200, group = G5)
float  narrowAtr = input.float(2.5, "窄通道 / 宽通道分界（通道高度 ATR）", minval = 0.5, maxval = 10.0, step = 0.5, group = G5, tooltip = "通道高度（两条平行线的垂直距离）小于该 ATR 倍数 → 记窄通道（强趋势）；否则宽通道（弱趋势）。")
color  cTL     = input.color(#1565c0, "趋势线", group = G5)
color  cCH     = input.color(#6a1b9a, "通道线", group = G5)

string G6 = "⑦ 重要高低点 / 过充 / 破位 / 通道 MM"
bool   showMajor = input.bool(true, "标重要高低点", group = G6, tooltip = "体系：「强势突破前面的低点就是重要低点」「大反转的前提是重要低点必须被跌破」。取「最强的那一段推进」的起点。")
int    mjLook   = input.int(80, "重要高低点回扫根数", minval = 20, maxval = 400, group = G6)
int    mjMinLen = input.int(5, "强突破段最少根数", minval = 2, maxval = 30, group = G6, tooltip = "挡掉「当根就是极值」这种退化情形 —— 否则一根 K 线的振幅就能算成一段推进。")
float  mjMinAtr = input.float(1.5, "强突破段最小幅度（ATR）", minval = 0.5, maxval = 10.0, step = 0.5, group = G6)
int    mjMinGap = input.int(10, "重要位最小间隔（根）", minval = 2, maxval = 100, group = G6)
int    keepMajor = input.int(4, "最多保留重要位", minval = 1, maxval = 8, group = G6)
bool   showOver = input.bool(true, "标通道线过充", group = G6, tooltip = "体系：「通道线我们经常用来判断一段趋势是不是过充了、是不是高潮了」。引线冲出通道线即过充；收盘也站上则不算过充，那是通道被上破。")
bool   showBreak = input.bool(true, "标趋势线破位 + 通道 MM", group = G6, tooltip = "体系：MTR 的第一个条件就是跌破趋势线。破位后按「区间形成段的一倍」给出通道 MM 目标。")
int    keepBreak = input.int(3, "最多保留破位记录", minval = 1, maxval = 8, group = G6)

string G7 = "⑧ 背景分段（把行情切成一段段）"
bool   showSeg  = input.bool(true, "显示背景分段带", group = G7, tooltip = "体系：不要拿「大区间」当「区间」做，要以当前的市场周期（当前这一段）为标准。这条带子就是替你把这一段段切出来。")
int    segConfirm = input.int(3, "分段需连续确认根数", minval = 1, maxval = 12, group = G7, tooltip = "段切换要连续这么多根同向才成立 —— 否则 20 根窗口的评分每抖一次就切一段。")
int    segMinBars = input.int(8, "一段的最少持续根数", minval = 1, maxval = 60, group = G7, tooltip = "一个段活够这么多根，才允许切走。挡掉 3~5 根的碎片段。")
int    keepSeg  = input.int(12, "图上保留段数", minval = 3, maxval = 40, group = G7)

string G8 = "显示"
bool   showPanel = input.bool(true, "显示背景面板", group = G8)
string panelPos  = input.string("右上", "面板位置", options = ["右上", "右下", "左上", "左下"], group = G8)
bool   showEma   = input.bool(true, "显示 EMA20（动态支撑阻力）", group = G8)
bool   showPivot = input.bool(true, "标记波段高低点", group = G8)
bool   showZone  = input.bool(false, "显示评估窗口高低（区间上下沿）", group = G8)


// ═══════════════════════════════ 基础量 ═══════════════════════════════

float atrV   = ta.atr(14)
float ema20  = ta.ema(close, 20)
float barRng = high - low
float bodyAb = math.abs(close - open)
float tickSz = syminfo.mintick


// ═══════════════ 证据一 · 枢轴与波段结构 ═══════════════
// ⚠ 不用 ta.pivothigh / ta.pivotlow：它们对「平台期」（相邻等高的极值）取哪一根
//   没有写死，而 _context_ref.py 的参考实现必须与脚本给出**完全一样**的枢轴，
//   否则趋势线会在两边分叉。这里自己数：
//   规则：左侧允许相等、右侧必须严格更小 → 确定性地取平台期最左边那根。
//   「右侧」是未来数据，所以只能在 bar(i + pvK) 才确认，并回填它的真实序号。

int  pvOff = pvK
bool phOk  = bar_index >= 2 * pvK
bool plOk  = bar_index >= 2 * pvK

if phOk
    for j = 1 to pvK
        if high[pvOff + j] > high[pvOff]
            phOk := false
            break
if phOk
    for j = 1 to pvK
        if high[pvOff - j] >= high[pvOff]
            phOk := false
            break
if plOk
    for j = 1 to pvK
        if low[pvOff + j] < low[pvOff]
            plOk := false
            break
if plOk
    for j = 1 to pvK
        if low[pvOff - j] <= low[pvOff]
            plOk := false
            break

// 证据一用的「最近 structN 个波段」
var array<float> hiAry = array.new<float>()
var array<float> loAry = array.new<float>()
// 趋势线用的「带序号的枢轴表」
var array<int>   plBar = array.new<int>()
var array<float> plVal = array.new<float>()
var array<int>   phBar = array.new<int>()
var array<float> phVal = array.new<float>()

if phOk
    float v = high[pvOff]
    int   b = bar_index - pvK
    array.push(hiAry, v)
    array.push(phBar, b)
    array.push(phVal, v)
    if array.size(hiAry) > structN
        array.shift(hiAry)
    if array.size(phBar) > keepPiv
        array.shift(phBar)
        array.shift(phVal)
if plOk
    float v2 = low[pvOff]
    int   b2 = bar_index - pvK
    array.push(loAry, v2)
    array.push(plBar, b2)
    array.push(plVal, v2)
    if array.size(loAry) > structN
        array.shift(loAry)
    if array.size(plBar) > keepPiv
        array.shift(plBar)
        array.shift(plVal)

// 序列中「递增」的比例，0..1
ascRatio(array<float> a) =>
    float r = 0.0
    int   n = array.size(a)
    if n >= 2
        int up = 0
        for i = 1 to n - 1
            if array.get(a, i) > array.get(a, i - 1)
                up += 1
        r := up / (n - 1)
    r

float hiRise = ascRatio(hiAry)
float loRise = ascRatio(loAry)

bool  structReady = array.size(hiAry) >= 2 and array.size(loAry) >= 2
float structScore = structReady ? (hiRise + loRise) - 1.0 : 0.0
// 扩张三角形：高点抬高 + 低点降低（本质是震荡区间）
bool  expanding = structReady and hiRise >= 0.66 and loRise <= 0.34


// ═══════════════ 结构方向（必须在通道模块之前）═══════════════
// 方向 = EMA20 斜率 + 价格相对位置，结构分强时覆盖。趋势线用它来决定
// 「取更高低点还是更低高点」，所以必须先算出来。

float emaSlope = ema20 - ema20[5]
int   trendDir = emaSlope > 0 and close > ema20 ? 1 : emaSlope < 0 and close < ema20 ? -1 : 0
if structScore > 0.20
    trendDir := 1
else if structScore < -0.20
    trendDir := -1


// ═══════════════ ⑥ 趋势线 / 通道线 ═══════════════
// 口径（蒋老师）：「顺着走势，发现有一个通道就画出来；发现更高高点或更低低点，
// 连接即可」「通道由两个点画出第三个点」。
//   趋势线 = 最近两个同向枢轴（higher=true → 更高的低点；false → 更低的高点）
//   通道线 = 过 [x1, x2] 区间内对面那个极值、与趋势线平行
// ⚠ 搜索顺序：i 从最新往回、j 从 i-1 往回 → 优先取「第二个点最新」的一对。
//   与 _context_ref.py 的 pick_trend_pair 逐字同构。

trendPair(array<int> bA, array<float> vA, bool higher, int minBars) =>
    int   x1 = na
    float y1 = na
    int   x2 = na
    float y2 = na
    int   n  = array.size(bA)
    if n >= 2
        for i = n - 1 to 1
            if na(x2)
                for j = i - 1 to 0
                    if array.get(bA, i) - array.get(bA, j) >= minBars
                        float vi = array.get(vA, i)
                        float vj = array.get(vA, j)
                        if higher ? vi > vj : vi < vj
                            x1 := array.get(bA, j)
                            y1 := vj
                            x2 := array.get(bA, i)
                            y2 := vi
                            break
    [x1, y1, x2, y2]

[upX1, upY1, upX2, upY2] = trendPair(plBar, plVal, true,  tlMinBars)
[dnX1, dnY1, dnX2, dnY2] = trendPair(phBar, phVal, false, tlMinBars)

bool  tlUp = true
// ⚠ 横坐标必须是 int，纵坐标才是 float —— 这里不能图省事全写 float：
//   Pine 的 `for k = a to b` 会让**计数器继承边界的类型**。边界是 float 时
//   计数器也变 float，于是下面 `extB := k` 报
//   CE10173: Cannot assign a value of the "float" type to the "int" variable.
//   同理 stX1/stX2 是 `var int`，tX1/tX2 若是 float 也一样报错（下一处就会撞）。
//   赋值统一套一层 int()：元组元素的类型推断若落到 float，也不会再翻车。
int   tX1  = na
float tY1  = na
int   tX2  = na
float tY2  = na
bool  tlHas = false
if trendDir > 0
    tlUp := true
    tX1 := int(upX1)
    tY1 := upY1
    tX2 := int(upX2)
    tY2 := upY2
    tlHas := not na(upX2)
else if trendDir < 0
    tlUp := false
    tX1 := int(dnX1)
    tY1 := dnY1
    tX2 := int(dnX2)
    tY2 := dnY2
    tlHas := not na(dnX2)
else
    // 方向未定 → 取「第二个点更近」的那一条
    if not na(upX2) and not na(dnX2)
        tlUp := upX2 >= dnX2
    else
        tlUp := not na(upX2)
    if tlUp
        tX1 := int(upX1)
        tY1 := upY1
        tX2 := int(upX2)
        tY2 := upY2
        tlHas := not na(upX2)
    else
        tX1 := int(dnX1)
        tY1 := dnY1
        tX2 := int(dnX2)
        tY2 := dnY2
        tlHas := not na(dnX2)

// 通道线：过 [x1, x2] 区间内与趋势线相对的那个极值，作平行线
float extV = na
int   extB = na
if tlHas and tX2 > tX1
    // tX1/tX2 已声明为 int → 计数器 k 也是 int，`extB := k` 才成立。
    // 升序扫描（与 _context_ref.py 的 max(range(x1, x2+1), key=...) 同序）：
    // 用严格 > / < 比较，因此**相等时留下最左那根**，与参考实现逐字一致。
    for k = tX1 to tX2
        // ⚠⚠ k 是**绝对 K 线序号**，不是「往回几根」。历史引用运算符 `[]` 只接受
        //    「往回根数」，所以必须写 high[bar_index - k]。
        //    写成 high[k] 有两个后果：① 语义错（取的是「k 根之前」那根，不是第 k 根）；
        //    ② 运行时报错 —— 在 bar 10001 上 k 动辄上千，直接撞
        //    "Invalid number of bars back ... accepts a value between 0 and 10000"。
        int off = bar_index - k
        // off 还需落在可取回的历史内（indicator 里 max_bars_back = 1000）。
        // 冷清行情下枢轴可能很老，超范围就跳过这一根 —— 宁可少画通道，也不要整脚本报错。
        if off >= 0 and off <= 999
            float v = tlUp ? high[off] : low[off]
            if na(extV) or (tlUp ? v > extV : v < extV)
                extV := v
                extB := k

float tlSlope = tlHas ? (tY2 - tY1) / (tX2 - tX1) : na
float tlAt    = tlHas ? tY1 + tlSlope * (bar_index - tX1) : na
float chAt    = tlHas and not na(extB) ? extV + tlSlope * (bar_index - extB) : na
float chW     = tlHas and not na(extB) ? math.abs((extV - tlSlope * extB) - (tY1 - tlSlope * tX1)) : na
float tlTol   = tlTolAtr * atrV

// ── 跨根状态：换线（x1/x2/方向变了）就全部重置 ──
var int   stX1     = na
var int   stX2     = na
var bool  stUp     = true
var bool  stBroken = false
var int   stBreakB = na
var int   stBreakT = na
var bool  stOverRun = false
var int   stOverB  = na
var int   stOverT  = na
var bool  stOverCb = false

bool lineChanged = tlHas and (na(stX2) or tX1 != stX1 or tX2 != stX2 or tlUp != stUp)

// ── 绘图对象 ──
var line  lnTL   = na
var line  lnCH   = na
var array<line> bMMLines = array.new<line>()
var array<line> mjLines  = array.new<line>()

// 通道 MM（破位后按「区间形成段的一倍」测量）
recordBreak() =>
    float mmv = tlUp ? close - chW : close + chW
    if chW > 0
        line l = line.new(bar_index, mmv, bar_index + tlExtend, mmv, color = color.new(#8e24aa, 0), width = 1, style = line.style_dashed)
        array.push(bMMLines, l)
        while array.size(bMMLines) > keepBreak
            line old = array.shift(bMMLines)
            if not na(old)
                line.delete(old)
    mmv

if lineChanged
    stX1 := tX1
    stX2 := tX2
    stUp := tlUp
    stBroken := false
    stBreakB := na
    stBreakT := na
    stOverRun := false
    stOverB := na
    stOverT := na
    stOverCb := false

// ① 破位检查（有效跌破要扣掉容差，否则一根引线就打掉趋势线）
if drawChan and tlHas and not stBroken and bar_index > tX2 and not na(tlAt)
    bool bk = tlUp ? close < tlAt - tlTol : close > tlAt + tlTol
    if bk
        stBroken := true
        stBreakB := bar_index
        stBreakT := time
        if showBreak
            recordBreak()

// ② 过充事件（体系：「通道线我们经常用来判断一段趋势是不是过充了、是不是高潮了」）
//    引线冲出通道线 = 过充；收盘也站上 → 那不是过充，是通道被上破 / 需重画。
//    记成事件：从冲出那根起、到重新回到通道内那根止。
bool overHit   = tlHas and not na(chAt) and (tlUp ? high > chAt : low < chAt)
bool overClose = tlHas and not na(chAt) and (tlUp ? close > chAt : close < chAt)

if drawChan and tlHas and not na(chAt)
    if overHit
        if not stOverRun
            stOverRun := true
            stOverB := bar_index
            stOverT := time
            stOverCb := false
        if overClose
            stOverCb := true
    else if stOverRun
        stOverRun := false

// ③ 画线（每次换线重建；未破位就继续向右延伸）
if drawChan and tlHas
    if lineChanged or na(lnTL)
        if not na(lnTL)
            line.delete(lnTL)
        if not na(lnCH)
            line.delete(lnCH)
        lnTL := line.new(tX1, tY1, bar_index + tlExtend, tlAt + tlSlope * tlExtend, color = color.new(cTL, 0), width = 2)
        lnCH := line.new(extB, extV, bar_index + tlExtend, chAt + tlSlope * tlExtend, color = color.new(cCH, 0), width = 1, style = line.style_dashed)
    else
        line.set_x2(lnTL, bar_index + tlExtend)
        line.set_y2(lnTL, tlAt + tlSlope * tlExtend)
        line.set_x2(lnCH, bar_index + tlExtend)
        line.set_y2(lnCH, chAt + tlSlope * tlExtend)
    if stBroken
        if not na(lnTL)
            line.set_color(lnTL, color.new(color.gray, 40))
            line.set_style(lnTL, line.style_dotted)
else if not drawChan and not na(lnTL)
    line.delete(lnTL)
    line.delete(lnCH)
    lnTL := na
    lnCH := na

bool chanNarrow = tlHas and not na(chW) and (chW / atrV) < narrowAtr


// ═══════════════ ⑦ 重要高低点 ═══════════════
// 体系原话：「强势突破前面的低点就是重要低点」
//            「你想要形成大反转，那么重要低点就得破」
// 实现：回扫 mjLook 根，取「单位时间位移最大」的那一段推进，它的起点就是
// 重要高/低点。mjMinLen 挡掉「当根就是极值」的退化情形（一根的振幅除以 1
// 会赢过任何长腿）。

var array<float> mjLv  = array.new<float>()
var array<int>   mjB   = array.new<int>()
var array<bool>  mjLow = array.new<bool>()   // true = 重要低点
var array<int>   mjBrk = array.new<int>()    // -1 = 未被破

float mjBestUp = 0.0
int   mjBestUpB = na
float mjBestUpV = na
float mjBestUpG = 0.0
float mjBestDn = 0.0
int   mjBestDnB = na
float mjBestDnV = na
float mjBestDnG = 0.0
float runHi = na
float runLo = na

int mjN = math.min(mjLook, bar_index + 1)
for b = 0 to mjN - 1
    int t = bar_index - b      // 绝对序号，只用于记录/画图
    // ⚠ b 本身就是「往回根数」→ 直接 high[b]。
    //   绝不能写 high[t]：t = bar_index - b 是绝对序号，b = 0 时 t = bar_index，
    //   在 bar 10001 上就是「往回 10001 根」→ 撞历史引用上限 10000 报错
    //   （用户实测：Error on bar 10001 ... at #main():428）。
    float bh = high[b]
    float bl = low[b]
    runHi := na(runHi) ? bh : math.max(runHi, bh)
    runLo := na(runLo) ? bl : math.min(runLo, bl)
    if b >= mjMinLen
        float upGain = runHi - bl
        float dnGain = bh - runLo
        if na(mjBestUpB) or upGain / (b + 1) > mjBestUp
            mjBestUp := upGain / (b + 1)
            mjBestUpG := upGain
            mjBestUpB := t
            mjBestUpV := bl
        if na(mjBestDnB) or dnGain / (b + 1) > mjBestDn
            mjBestDn := dnGain / (b + 1)
            mjBestDnG := dnGain
            mjBestDnB := t
            mjBestDnV := bh

// 记录函数：同侧、且**尚未被破**的旧记录会被新的取代 —— 决定盘面的永远是
// 「最近那一段强突破的起点」；已被破的留着当历史。
mjPush(bool isLow, float lv, int b) =>
    int n = array.size(mjLv)
    bool dup = false
    if n > 0
        for i = 0 to n - 1
            if array.get(mjLow, i) == isLow and array.get(mjB, i) == b
                dup := true
    // ⚠ tooNear 必须用 if 包住：Pine 的 and 不保证短路，写成
    //   `n > 0 and array.get(mjLow, n - 1) == ...` 在 n == 0 时会
    //   array.get(..., -1) → 越界运行时报错。
    bool tooNear = false
    if n > 0
        if array.get(mjLow, n - 1) == isLow and math.abs(b - array.get(mjB, n - 1)) < mjMinGap
            tooNear := true
    if not dup and not tooNear
        // 移除同侧且未被破的旧记录（它已经被新的强突破段取代）
        // ⚠ 必须加 `array.size > 0` 守卫：Pine 的 `for i = -1 to 0` 是**从 -1 数到 0**
        //   （from < to 时自动升序），会拿 -1 去 array.get → 越界运行时报错。
        if array.size(mjLv) > 0
            for i = array.size(mjLv) - 1 to 0
                if array.get(mjLow, i) == isLow and array.get(mjBrk, i) < 0
                    array.remove(mjLv, i)
                    array.remove(mjB, i)
                    array.remove(mjLow, i)
                    array.remove(mjBrk, i)
        array.push(mjLv, lv)
        array.push(mjB, b)
        array.push(mjLow, isLow)
        array.push(mjBrk, -1)
        while array.size(mjLv) > keepMajor
            array.shift(mjLv)
            array.shift(mjB)
            array.shift(mjLow)
            array.shift(mjBrk)
        if showMajor
            line l = line.new(b, lv, bar_index + tlExtend, lv, color = color.new(isLow ? #00897b : #e53935, 0), width = 1)
            array.push(mjLines, l)
            while array.size(mjLines) > keepMajor
                line old = array.shift(mjLines)
                if not na(old)
                    line.delete(old)
    array.size(mjLv)

if not na(mjBestUpB) and mjBestUpG >= mjMinAtr * atrV
    mjPush(true, mjBestUpV, mjBestUpB)
if not na(mjBestDnB) and mjBestDnG >= mjMinAtr * atrV
    mjPush(false, mjBestDnV, mjBestDnB)

// 重要位是否已被跌破 / 升破
if array.size(mjLv) > 0
    for i = 0 to array.size(mjLv) - 1
        if array.get(mjBrk, i) < 0
            bool hit = array.get(mjLow, i) ? close < array.get(mjLv, i) : close > array.get(mjLv, i)
            if hit
                array.set(mjBrk, i, bar_index)

int    nMajor  = array.size(mjLv)
float  majLo   = na
float  majHi   = na
bool   majLoBrk = false
bool   majHiBrk = false
if nMajor > 0
    for i = nMajor - 1 to 0
        if array.get(mjLow, i) and na(majLo)
            majLo := array.get(mjLv, i)
            majLoBrk := array.get(mjBrk, i) >= 0
        if not array.get(mjLow, i) and na(majHi)
            majHi := array.get(mjLv, i)
            majHiBrk := array.get(mjBrk, i) >= 0

// 重要位横线一直延伸到最右侧
if barstate.islast and showMajor and array.size(mjLines) > 0
    int nm = array.size(mjLines)
    for i = 0 to nm - 1
        if not na(array.get(mjLines, i))
            line.set_x2(array.get(mjLines, i), bar_index + tlExtend)


// ═══════════════ 证据二 · 缺口是否敞开（体系核心）═══════════════
// 体系口径（不是跳空）：被反向实体（收盘价）突破的那根 K 线的极值就是缺口位 ——
//   向下缺口 = 阴线实体跌破的那根【阳线的最低价】
//   向上缺口 = 阳线实体突破的那根【阴线的最高价】
// 该价位即「被套方打平离场」的位置。
// 参考 K 线的取法：从触发 K 往前找最近的一根反向实体 K 线（中间可隔同向 K 线）。
// 回补判据：引线触及缺口位即算回补。
// 去重规则：同方向 + 同价位上若已有【未回补】缺口 → 不另记（同一批被套方）；
// 缺口一旦回补就「让出」该价位，之后再次被反向实体突破 = 一批【新的】被套方。

var float gLastBullLow  = na
var float gLastBearHigh = na

// 【双表分离】① 未回补登记表 = 口径来源（不裁剪，只存未回补，兼作去重表）
var array<float> gOpenLv  = array.new<float>()
var array<int>   gOpenDir = array.new<int>()      // +1 向上 / -1 向下

// ② 绘图 / 历史表（可裁剪，用于画线 + 「最近 N 根」统计）
var array<float> gLv     = array.new<float>()
var array<int>   gDir    = array.new<int>()
var array<bool>  gFilled = array.new<bool>()
var array<int>   gBorn   = array.new<int>()
var array<int>   gFillBar = array.new<int>()
var array<line>  gLine   = array.new<line>()

int keepGaps = 60
// ⚠ keepGaps 只裁绘图/历史表；口径表不参与裁剪（渲染容量不得改变口径）

if array.size(gOpenLv) > 0
    for i = array.size(gOpenLv) - 1 to 0
        bool  up = array.get(gOpenDir, i) > 0
        float lv = array.get(gOpenLv, i)
        bool  hit = up ? low <= lv : high >= lv
        if hit
            array.remove(gOpenLv, i)
            array.remove(gOpenDir, i)
            if array.size(gLv) > 0
                for k = array.size(gLv) - 1 to 0
                    if not array.get(gFilled, k) and array.get(gDir, k) == (up ? 1 : -1) and math.abs(array.get(gLv, k) - lv) < tickSz
                        array.set(gFilled, k, true)
                        array.set(gFillBar, k, bar_index)
                        if not na(array.get(gLine, k))
                            line gl = array.get(gLine, k)
                            line.set_color(gl, color.new(color.gray, 70))
                            line.set_style(gl, line.style_dotted)
                        break

bool gapBull = close > open
bool gapBear = close < open

// 去重规则：同方向 + 同价位上若已有【未回补】缺口 → 不另记（那是同一批被套方）。
// ⚠ 不设 used 标志：同一个极值可能被不同 K 线各突破一次（各自成立）。
alreadyOpenG(int d, float p) =>
    bool found = false
    if array.size(gOpenLv) > 0
        for i = array.size(gOpenLv) - 1 to 0
            if array.get(gOpenDir, i) == d and math.abs(array.get(gOpenLv, i) - p) < tickSz
                found := true
                break
    found

if gapBear and not na(gLastBullLow) and close < gLastBullLow - tickSz and not alreadyOpenG(-1, gLastBullLow)
    array.push(gOpenLv, gLastBullLow)
    array.push(gOpenDir, -1)
    array.push(gLv, gLastBullLow)
    array.push(gDir, -1)
    array.push(gFilled, false)
    array.push(gBorn, bar_index)
    array.push(gFillBar, -1)
    line nl = na
    if drawGap
        nl := line.new(bar_index, gLastBullLow, bar_index + 20, gLastBullLow, color = color.new(cGapDn, 0), width = 2)
    array.push(gLine, nl)

if gapBull and not na(gLastBearHigh) and close > gLastBearHigh + tickSz and not alreadyOpenG(1, gLastBearHigh)
    array.push(gOpenLv, gLastBearHigh)
    array.push(gOpenDir, 1)
    array.push(gLv, gLastBearHigh)
    array.push(gDir, 1)
    array.push(gFilled, false)
    array.push(gBorn, bar_index)
    array.push(gFillBar, -1)
    line nl2 = na
    if drawGap
        nl2 := line.new(bar_index, gLastBearHigh, bar_index + 20, gLastBearHigh, color = color.new(cGapUp, 0), width = 2)
    array.push(gLine, nl2)

if gapBull
    gLastBullLow := low
if gapBear
    gLastBearHigh := high

if array.size(gLv) > keepGaps
    line oldLn = array.shift(gLine)
    if not na(oldLn)
        line.delete(oldLn)
    array.shift(gLv)
    array.shift(gDir)
    array.shift(gFilled)
    array.shift(gBorn)
    array.shift(gFillBar)

int openGaps     = array.size(gOpenLv)
int openUpGaps   = 0
int openDnGaps   = 0
int recentGaps   = 0
int recentFilled = 0
int recentFake   = 0

if array.size(gOpenDir) > 0
    for i = 0 to array.size(gOpenDir) - 1
        if array.get(gOpenDir, i) > 0
            openUpGaps += 1
        else
            openDnGaps += 1

if array.size(gLv) > 0
    int ng = array.size(gLv)
    for i = 0 to ng - 1
        bool fl = array.get(gFilled, i)
        if bar_index - array.get(gBorn, i) <= gapLook
            recentGaps += 1
            if fl
                recentFilled += 1
                if (array.get(gFillBar, i) - array.get(gBorn, i)) <= fastBars
                    recentFake += 1

bool  lastGapFound = array.size(gLv) > 0
bool  lastGapOpen  = false
float lastGapLevel = na
if lastGapFound
    lastGapOpen  := not array.get(gFilled, array.size(gLv) - 1)
    lastGapLevel := array.get(gLv, array.size(gLv) - 1)

if barstate.islast and drawGap and array.size(gLine) > 0
    int ng2 = array.size(gLine)
    for i = 0 to ng2 - 1
        if not array.get(gFilled, i) and not na(array.get(gLine, i))
            line.set_x2(array.get(gLine, i), bar_index + 20)


// ═══════════════ 证据三 · 回调的持续时间与幅度 ═══════════════

float winHi  = ta.highest(high, chopLen)
float winLo  = ta.lowest(low, chopLen)
int   barsHi = ta.highestbars(high, chopLen)
int   barsLo = ta.lowestbars(low, chopLen)

float legRng  = winHi - winLo
float pullRet = 0.0
int   pullBar = 0

if legRng > 0
    if barsLo < barsHi
        pullRet := (winHi - close) / legRng
        pullBar := -barsHi
    else
        pullRet := (close - winLo) / legRng
        pullBar := -barsLo


// ═══════════════ 证据四/五 · 重叠度与 K 线质量 ═══════════════

float ovlSum  = 0.0
int   ovlCnt  = 0
int   dojiCnt = 0

for i = 1 to chopLen
    float up1 = math.max(high[i], high[i - 1])
    float dn1 = math.min(low[i], low[i - 1])
    float uni = up1 - dn1
    if uni > 0
        float inter = math.min(high[i], high[i - 1]) - math.max(low[i], low[i - 1])
        ovlSum += math.max(0.0, math.min(1.0, inter / uni))
        ovlCnt += 1

for i = 0 to chopLen - 1
    if barRng[i] > 0 and bodyAb[i] / barRng[i] < dojiBody
        dojiCnt += 1

float avgOvl  = ovlCnt > 0 ? ovlSum / ovlCnt : 0.0
float dojiPct = dojiCnt / chopLen

int goodCnt = 0
int withCnt = 0
int oppMax  = 0
int oppCur  = 0

for i = chopLen - 1 to 0
    bool isUpBar = close[i] > open[i]
    bool withT   = trendDir > 0 ? isUpBar : (trendDir < 0 ? not isUpBar : false)
    if trendDir == 0
        oppCur := 0
    else if withT
        withCnt += 1
        if barRng[i] > 0 and bodyAb[i] / barRng[i] >= bodyFull
            goodCnt += 1
        oppCur := 0
    else
        oppCur += 1
        oppMax := math.max(oppMax, oppCur)

float bodyQuality = withCnt > 0 ? goodCnt / withCnt : 0.5


// ═════════════════════ 评分与周期分级 ═════════════════════

float sGap = 0.0
if not useGap
    sGap := 0.50
else if openGaps > 0
    sGap := 1.00
else if recentGaps == 0
    sGap := 0.25
else if recentFilled > 0 and recentFake == recentFilled
    sGap := 0.15
else
    sGap := 0.40

float s1 = math.min(1.0, math.abs(structScore))                       // 结构清晰度
float s2 = sGap                                                       // 缺口敞开
float s3 = 1.0 - math.min(1.0, pullRet / deepPct)                     // 回调浅度
float s4 = 1.0 - math.min(1.0, avgOvl / 0.80)                         // 重叠低度（铁丝网反向）
float s5 = bodyQuality                                               // 顺势实体饱满度
float s6 = oppMax < oppRunMx ? 1.0 : 0.0                             // 逆势无长跟随
float s7 = pullBar > longBars ? 0.0 : 1.0                            // 回调未过长
// ⑥ 通道质量：趋势线完好且价格在正确一侧 → 1；已破位 → 0；无趋势线 → 中性
float s8 = 0.5
if drawChan and tlHas
    if stBroken
        s8 := 0.0
    else if (tlUp and close >= tlAt) or (not tlUp and close <= tlAt)
        s8 := 1.0
    else
        s8 := 0.3

float score = 0.20 * s1 + 0.20 * s2 + 0.14 * s3 + 0.12 * s4 + 0.09 * s5 + 0.07 * s6 + 0.08 * s7 + 0.10 * s8

string phase   = "震荡区间"
color  phaseCol = #ef5350
string advice  = "耐心等顶底 · 高抛低吸 · 压注突破失败"

if expanding
    phase    := "扩张三角形（本质是震荡）"
    phaseCol := #f4a300
    advice   := "双向交易 · 压注突破失败"
else if score >= 0.72
    if avgOvl < 0.22 and not chanNarrow
        phase := "突破 / 急速（Spike）"
    else
        phase := "窄通道（强趋势）"
    phaseCol := #26a69a
    advice   := trendDir >= 0 ? "顺势做多（80% 的反转是小反转）" : "顺势做空（80% 的反转是小反转）"
else if score >= 0.55
    phase    := "宽通道（弱趋势 · 阶梯模式）"
    phaseCol := #8bc34a
    advice   := trendDir >= 0 ? "回调顺势做多 · 缺口大概率会被回补" : "反弹顺势做空 · 缺口大概率会被回补"
else
    phase    := avgOvl > 0.70 and legRng < 6 * atrV ? "窄幅震荡 TTR（几乎不操作）" : "震荡区间"
    phaseCol := #ef5350
    advice   := "耐心等顶底 · 高抛低吸 · 压注突破失败"

string conf = score >= 0.75 or score <= 0.35 ? "高" : "中"


// ═══════════════ ⑧ 背景分段（把行情切成一段段）═══════════════
// 体系：「不要拿『大区间』当『区间』做……以当前的市场周期（当前这一段）为标准
// 去做单」。这条带子就是替人把「区间段 / 趋势段」切出来。
// 段切换要过两道闸：① 连续 segConfirm 根同向；② 旧段已活够 segMinBars 根。
// 只过第一道的话，20 根窗口的评分每抖一次就切一段（实测 198 根切出 20 段）。

kindOf(string p) =>
    int k = 4
    if str.startswith(p, "扩张")
        k := 6
    else if str.startswith(p, "突破")
        k := 1
    else if str.startswith(p, "窄通道")
        k := 2
    else if str.startswith(p, "窄幅")
        k := 5
    else if str.startswith(p, "宽通道")
        k := 3
    k

kindName(int k) =>
    string s = "震荡区间"
    if k == 1
        s := "① 突破/急速"
    else if k == 2
        s := "② 窄通道"
    else if k == 3
        s := "③ 宽通道"
    else if k == 4
        s := "④ 震荡区间"
    else if k == 5
        s := "⑤ 窄幅TTR"
    else if k == 6
        s := "⑥ 扩张三角"
    s

kindColor(int k) =>
    color c = #ef9a9a
    if k == 1
        c := #80cbc4
    else if k == 2
        c := #b2dfdb
    else if k == 3
        c := #ffe082
    else if k == 4
        c := #ef9a9a
    else if k == 5
        c := #b0bec5
    else if k == 6
        c := #ce93d8
    c

int kindNow = kindOf(phase)

var array<box>   segBox = array.new<box>()
var array<label> segLbl = array.new<label>()
var int   segKind  = 0
var int   segStart = 0
var float segHi    = na
var float segLo    = na
var int   pendKind = 0
var int   pendCnt  = 0
var int   segNo    = 0

var box   curBox = na
var label curLbl = na

if showSeg
    if segKind == 0 or na(curBox)
        // na(curBox) 也要走这里：分段开关被关掉再打开时，段状态还在但画布已经删了
        if segKind == 0
            segStart := bar_index
            segNo += 1
        segKind := kindNow
        segHi := high
        segLo := low
        color kc = kindColor(segKind)
        curBox := box.new(segStart, segHi, bar_index, segLo, border_color = color.new(kc, 30), border_width = 1, bgcolor = color.new(kc, 86))
        array.push(segBox, curBox)
        curLbl := label.new(segStart, segHi, str.tostring(segNo) + " " + kindName(segKind), style = label.style_label_down, color = color.new(kc, 20), textcolor = #263238, size = size.small)
        array.push(segLbl, curLbl)
    else if kindNow != segKind
        pendCnt := kindNow == pendKind ? pendCnt + 1 : 1
        pendKind := kindNow
        if pendCnt >= segConfirm and (bar_index - segStart) >= segMinBars
            int neuStart = bar_index - segConfirm + 1
            // 旧段收尾于新段起点的前一根 → 无缝首尾相接
            box.set_right(curBox, neuStart - 1)
            segKind := kindNow
            segStart := neuStart
            segHi := high
            segLo := low
            for q = neuStart to bar_index
                // 同上的坑：q 是绝对序号，偏移要写成 bar_index - q
                // （q = bar_index 时正好是 0 → 当前根）
                int qo = bar_index - q
                segHi := math.max(segHi, high[qo])
                segLo := math.min(segLo, low[qo])
            segNo += 1
            color kc2 = kindColor(segKind)
            curBox := box.new(segStart, segHi, bar_index, segLo, border_color = color.new(kc2, 30), border_width = 1, bgcolor = color.new(kc2, 86))
            array.push(segBox, curBox)
            curLbl := label.new(segStart, segHi, str.tostring(segNo) + " " + kindName(segKind), style = label.style_label_down, color = color.new(kc2, 20), textcolor = #263238, size = size.small)
            array.push(segLbl, curLbl)
            pendCnt := 0
            while array.size(segBox) > keepSeg
                box ob = array.shift(segBox)
                if not na(ob)
                    box.delete(ob)
                label ol = array.shift(segLbl)
                if not na(ol)
                    label.delete(ol)
    segHi := math.max(segHi, high)
    segLo := math.min(segLo, low)
    if not na(curBox)
        box.set_right(curBox, bar_index)
        box.set_top(curBox, segHi)
        box.set_bottom(curBox, segLo)
    if not na(curLbl)
        label.set_y(curLbl, segHi)
else if not na(curBox)
    box.delete(curBox)
    label.delete(curLbl)
    curBox := na
    curLbl := na

int segLen = segKind == 0 ? 0 : bar_index - segStart + 1


// ═════════════════════════════ 绘图 ═════════════════════════════

plot(showEma ? ema20 : na, title = "EMA20", color = color.new(#2962ff, 0), linewidth = 2)

plot(showZone ? winHi : na, title = "窗口最高", color = color.new(color.gray, 30), linewidth = 1, style = plot.style_stepline)
plot(showZone ? winLo : na, title = "窗口最低", color = color.new(color.gray, 30), linewidth = 1, style = plot.style_stepline)

plotshape(showPivot and phOk, title = "波段高点", style = shape.triangledown, location = location.abovebar, color = color.new(#ef5350, 0), size = size.tiny, offset = -pvK)
plotshape(showPivot and plOk, title = "波段低点", style = shape.triangleup, location = location.belowbar, color = color.new(#26a69a, 0), size = size.tiny, offset = -pvK)

// 通道区间淡色填充：fill() 只能作用于 plot，不能作用于 line，
// 所以用两条隐形 plot 夹住通道的上下沿。（历史每根上这两个值都是用**当时**的
// 那组枢轴算的，所以回看时填的就是当时的通道，不是拿现在的线回头去套。）
pChanLo = plot(drawChan and fillChan ? tlAt : na, "通道下沿", color = color.new(cTL, 100), display = display.none)
pChanHi = plot(drawChan and fillChan ? chAt : na, "通道上沿", color = color.new(cCH, 100), display = display.none)
fill(pChanLo, pChanHi, color = color.new(cTL, 94), title = "通道区间")

// 通道过充标记（事件的起点那一根）：用 location.absolute + 通道线的价位，
// 这样上通道标在上方、下通道标在下方，不需要在 location 上做三元判断。
bool overStartBar = showOver and drawChan and stOverRun and not na(chAt) and (tlUp ? high[1] <= chAt[1] : low[1] >= chAt[1])
plotshape(overStartBar ? chAt : na, title = "通道过充", style = shape.circle, location = location.absolute, color = color.new(#ef6c00, 0), size = size.tiny)

// 趋势线破位标记
bool breakBarNow = showBreak and drawChan and stBroken and stBreakB == bar_index
plotshape(breakBarNow ? (tlUp ? low : high) : na, title = "趋势线破位", style = shape.xcross, location = location.absolute, color = color.new(#c2185b, 0), size = size.small)


// ═════════════════════════════ 背景面板 ═════════════════════════════

string pPos = panelPos == "右上" ? position.top_right : panelPos == "右下" ? position.bottom_right : panelPos == "左上" ? position.top_left : position.bottom_left
var table pnl = table.new(pPos, 3, 15, border_width = 1, frame_width = 1, frame_color = color.new(color.gray, 45))

cell(int col, int row, string txt, color txtCol, color bgCol, string halign) =>
    table.cell(pnl, col, row, txt, text_color = txtCol, bgcolor = bgCol, text_size = size.small, text_halign = halign)

if showPanel and barstate.islast
    table.clear(pnl, 0, 0, 2, 14)

    color tHead = color.new(#37474f, 0)
    color tKey  = color.new(#eceff1, 0)
    color tVal  = color.new(#ffffff, 0)
    color tTxt  = color.new(#263238, 0)
    string hhmm = str.format_time(time, "HH:mm", syminfo.timezone)

    table.merge_cells(pnl, 0, 0, 2, 0)
    table.cell(pnl, 0, 0, "Zpa 01 · 市场背景（二元决策 + 通道划分）", text_color = color.white, bgcolor = tHead, text_size = size.small, text_halign = text.align_center)

    cell(0, 1, "结论", tVal, tKey, text.align_left)
    table.merge_cells(pnl, 1, 1, 2, 1)
    table.cell(pnl, 1, 1, phase + "　置信度：" + conf, text_color = color.white, bgcolor = phaseCol, text_size = size.normal, text_halign = text.align_left)

    table.merge_cells(pnl, 0, 2, 2, 2)
    table.cell(pnl, 0, 2, "策略： " + advice, text_color = tTxt, bgcolor = color.new(#f5f5f5, 0), text_size = size.small, text_halign = text.align_left)

    cell(0, 3, "当前段", tTxt, tKey, text.align_left)
    table.merge_cells(pnl, 1, 3, 2, 3)
    table.cell(pnl, 1, 3, (showSeg ? "第 " + str.tostring(segNo) + " 段 · " + kindName(segKind) + " · 已 " + str.tostring(segLen) + " 根" : "分段已关闭"), text_color = tTxt, bgcolor = tVal, text_size = size.small, text_halign = text.align_left)

    cell(0, 4, "⑥ 通道", tTxt, tKey, text.align_left)
    cell(1, 4, tlHas ? (tlUp ? "上涨" : "下跌") + "通道　斜率 " + str.tostring(tlSlope, "#.00") + " 点/根　高 " + str.tostring(chW, format.mintick) + "（" + str.tostring(chW / atrV, "#.0") + " ATR）" : "枢轴对不足，暂无趋势线", tTxt, tVal, text.align_left)
    cell(2, 4, tlHas ? (chanNarrow ? "窄通道" : "宽通道") : "-", tTxt, tVal, text.align_left)

    cell(0, 5, "趋势线状态", tTxt, tKey, text.align_left)
    string tlStateTxt = "-"
    if drawChan and tlHas
        if stBroken
            tlStateTxt := "已破位 " + str.format_time(nz(stBreakT, time), "HH:mm", syminfo.timezone)
        else
            tlStateTxt := "完好　距线 " + str.tostring((close - tlAt) / atrV, "#.0") + " ATR"
    cell(1, 5, tlStateTxt, tTxt, tVal, text.align_left)
    cell(2, 5, not tlHas ? "-" : stOverRun ? "过充中·自 " + str.format_time(nz(stOverT, time), "HH:mm", syminfo.timezone) + (stOverCb ? "·收盘站上" : "") : "未过充", tTxt, tVal, text.align_left)

    cell(0, 6, "重要低点", tTxt, tKey, text.align_left)
    cell(1, 6, na(majLo) ? "未识别" : str.tostring(majLo, format.mintick), tTxt, tVal, text.align_left)
    cell(2, 6, na(majLo) ? "-" : majLoBrk ? "已被跌破" : "未破（大反转前提）", tTxt, tVal, text.align_left)

    cell(0, 7, "重要高点", tTxt, tKey, text.align_left)
    cell(1, 7, na(majHi) ? "未识别" : str.tostring(majHi, format.mintick), tTxt, tVal, text.align_left)
    cell(2, 7, na(majHi) ? "-" : majHiBrk ? "已被升破" : "未破（大反转前提）", tTxt, tVal, text.align_left)

    cell(0, 8, "① 波段结构", tTxt, tKey, text.align_left)
    cell(1, 8, "高点递增 " + str.tostring(math.round(hiRise * 100)) + "% ／ 低点递增 " + str.tostring(math.round(loRise * 100)) + "%", tTxt, tVal, text.align_left)
    cell(2, 8, expanding ? "外扩" : structScore > 0.2 ? "多头" : structScore < -0.2 ? "空头" : "混杂", tTxt, tVal, text.align_left)

    cell(0, 9, "② 缺口敞开", tTxt, tKey, text.align_left)
    cell(1, 9, "未回补 " + str.tostring(openGaps) + "（上 " + str.tostring(openUpGaps) + "／下 " + str.tostring(openDnGaps) + "）　近 " + str.tostring(gapLook) + " 根制造 " + str.tostring(recentGaps) + " 个（快速回补 " + str.tostring(recentFake) + "）", tTxt, tVal, text.align_left)
    cell(2, 9, openGaps > 0 ? "强" : recentGaps == 0 ? "无缺口" : recentFake == recentFilled ? "假突破" : "全回补", tTxt, tVal, text.align_left)

    cell(0, 10, "③ 回调", tTxt, tKey, text.align_left)
    cell(1, 10, "深度 " + str.tostring(math.round(pullRet * 100)) + "% ／ 时长 " + str.tostring(pullBar) + " 根", tTxt, tVal, text.align_left)
    cell(2, 10, pullRet >= deepPct or pullBar > longBars ? "偏深/偏长" : "健康", tTxt, tVal, text.align_left)

    cell(0, 11, "④ 重叠/铁丝网", tTxt, tKey, text.align_left)
    cell(1, 11, "平均重叠 " + str.tostring(math.round(avgOvl * 100)) + "% ／ 小实体 " + str.tostring(math.round(dojiPct * 100)) + "%", tTxt, tVal, text.align_left)
    cell(2, 11, avgOvl >= 0.50 ? "重叠多" : avgOvl <= 0.25 ? "推进顺" : "一般", tTxt, tVal, text.align_left)

    cell(0, 12, "⑤ K 线质量", tTxt, tKey, text.align_left)
    cell(1, 12, "顺势实体饱满 " + str.tostring(math.round(bodyQuality * 100)) + "% ／ 逆势最长连续 " + str.tostring(oppMax) + " 根", tTxt, tVal, text.align_left)
    cell(2, 12, bodyQuality >= 0.55 and oppMax < oppRunMx ? "好" : "跟随差", tTxt, tVal, text.align_left)

    cell(0, 13, "背景惯性", tTxt, tKey, text.align_left)
    table.merge_cells(pnl, 1, 13, 2, 13)
    table.cell(pnl, 1, 13, lastGapFound ? (lastGapOpen ? "最后一个缺口未回补 " + str.tostring(lastGapLevel, format.mintick) + " → 引导趋势的机构仍在" : "最后一个缺口已回补 " + str.tostring(lastGapLevel, format.mintick) + " → 注意趋势转弱") : "本窗口暂无缺口记录", text_color = tTxt, bgcolor = tVal, text_size = size.small, text_halign = text.align_left)

    table.merge_cells(pnl, 0, 14, 2, 14)
    table.cell(pnl, 0, 14, "趋势分 " + str.tostring(score, "#.00") + "（含通道分 " + str.tostring(s8, "#.00") + "）　·　" + hhmm + "　·　按该体系推演，非投资建议", text_color = color.new(#546e7a, 0), bgcolor = color.new(#fafafa, 0), text_size = size.small, text_halign = text.align_left)


// ═════════════════════════════ 告警 ═════════════════════════════

alertcondition(score >= 0.72 and score[1] < 0.72, "Zpa 转强趋势", "背景分上穿 0.72：趋势/窄通道")
alertcondition(score < 0.55 and score[1] >= 0.55, "Zpa 转震荡", "背景分下穿 0.55：进入震荡区间")
alertcondition(openGaps > 0 and openGaps[1] == 0, "Zpa 新缺口敞开", "出现未回补的突破型缺口")
alertcondition(drawChan and stBroken and not stBroken[1], "Zpa 趋势线破位", "趋势线被有效跌破/升破 —— MTR 的第一个条件")
alertcondition(drawChan and stOverRun and not stOverRun[1], "Zpa 通道过充", "价格冲出通道线：判断趋势是否过充/高潮")
alertcondition(showSeg and kindNow != kindNow[1] and segKind == kindNow and segNo > 1, "Zpa 背景段切换", "市场周期（当前这一段）发生切换")
